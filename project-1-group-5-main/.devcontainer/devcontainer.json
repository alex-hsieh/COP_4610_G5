{
  "name": "COP4610 Shell (C)",
  "dockerFile": "Dockerfile",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools",
        "ms-vscode.cpptools-extension-pack"
      ],
      "settings": {
        "C_Cpp.default.compilerPath": "/usr/bin/gcc",
        "files.exclude": {
          "**/obj": true
        }
      }
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y build-essential gdb make valgrind && make"
}